# Generated by scripts/build-lineup.js. These are committed build outputs and are
# compared byte-for-byte against fresh generator output by tests/lineup.test.js
# and `npm run verify:generated`. Without an explicit eol, a Windows checkout
# rewrites them to CRLF, so a clean checkout fails the test suite and the release
# gate even though the committed content is correct.
app/data/public-channels.m3u text eol=lf
app/default-playlist.js text eol=lf

# Shell and workflow files must stay LF on every platform.
*.sh text eol=lf
